# PostgreSQL connection string (Neon). Either name works.
NEON_DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://...

PORT=4000

# Signing secret for login tokens. If missing, the server generates one and
# appends it to .env on first start (so logins survive restarts).
# TOKEN_SECRET=

# Set to "off" to disable the simulated SMS sender (batches stay queued).
SMS_SIMULATION=on
