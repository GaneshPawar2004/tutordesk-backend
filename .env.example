# Copy to .env and fill in.
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (Neon). DATABASE_URL also works.
NEON_DB_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Long random string for signing logins, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# (JWT_SECRET also works.)
TOKEN_SECRET=change-me
JWT_EXPIRES_IN=30d

# Comma-separated websites allowed to call the API from a browser (mobile apps don't need this).
# (CORS_ORIGINS also works.)
ALLOWED_ORIGINS=

# Email for OTPs. If SMTP_HOST is empty, OTPs are printed to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kaksha <no-reply@example.com>"

# New-account defaults
TRIAL_DAYS=14
DEFAULT_STAFF_LOGIN_LIMIT=0

# Secret for /api/v1/admin routes (adjust plans, extend trials). Leave empty to disable.
ADMIN_API_KEY=
