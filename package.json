{
  "name": "kaksha-backend",
  "version": "1.0.0",
  "description": "REST API for the Kaksha teachers app",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
